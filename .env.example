# C-Guard admin-only deployment environment.
# Copy this file to .env and replace every change-me value before production use.

# Server identity used by the nginx self-signed certificate generator.
SERVER_IP=127.0.0.1

# C-Guard persistence database.
POSTGRES_PASSWORD=change-me-strong-postgres-password

# C-Guard admin API and admin login token signing.
CGUARD_ADMIN_API_KEY=change-me-cguard-admin-api-key
CGUARD_ADMIN_SIGNING_SECRET=change-me-32-plus-random-characters
CGUARD_ADMIN_TOKEN_TTL_SEC=14400
CGUARD_ADMIN_USERNAME=admin
CGUARD_ADMIN_PASSWORD=change-me-strong-admin-password
CGUARD_ADMIN_ROLE=enforcer

# Shared token for integration APIs. Keep it strong even when not exposing /v1/integration/*.
CGUARD_INTEGRATION_TOKEN=change-me-cguard-integration-token
